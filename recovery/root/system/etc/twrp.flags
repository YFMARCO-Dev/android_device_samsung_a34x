# Logical
/system_image             emmc      system                                flags=display="System_Image";logical;flashimg=1;backup=1
/vendor_image             emmc     vendor                                flags=display="Vendor_Image";logical;flashimg=1;backup=1
/product_image            emmc     product                               flags=display="Product_Image";logical;flashimg=1;backup=1
#/odm                emmc     odm                                   flags=display="odm";logical
/system_ext_image         erofs     system_ext                            flags=display="System_ext_Image";logical;flashimg=1;backup=1
#/vendor_dlkm        erofs     vendor_dlkm                           flags=display="vendor_dlkm";logical
#/system_dlkm        ext4      system_dlkm                           flags=display="system_dlkm";logical
#/odm_dlkm           erofs     odm_dlkm                              flags=display="odm_dlkm";logical

# Other
/boot               emmc      /dev/block/by-name/boot               flags=display="Boot";flashimg=1;backup=1
/recovery           emmc      /dev/block/by-name/recovery           flags=display="Recovery";flashimg=1;backup=1
/data               f2fs      /dev/block/by-name/userdata           flags=display="Data";backup=1
/cache              ext4      /dev/block/by-name/cache              flags=display="Cache";backup=1
/efs                ext4      /dev/block/by-name/sec_efs            flags=display="efs";backup=1
/carrier            ext4      /dev/block/by-name/carrier            flags=display="carrier";backup=1
/metadata           ext4      /dev/block/by-name/metadata           flags=display="metadata";backup=1
/modem              emmc      /dev/block/by-name/apnhlos            flags=display="modem";backup=1
/dtbo               emmc      /dev/block/by-name/dtbo               flags=display="dtbo";flashimg=1;backup=1
#/keydata            ext4      /dev/block/by-name/keydata            flags=display="keydata";backup=1
#/keyrefuge          f2fs      /dev/block/by-name/keyrefuge          flags=display="keyrefuge"backup=1
/optics             ext4      /dev/block/by-name/optics             flags=display="optics";backup=1
/prism              ext4      /dev/block/by-name/prism              flags=display="prism";backup=1
/vbmeta_samsung     emmc      /dev/block/by-name/vbmeta_samsung     flags=display="vbmeta_samsung"flashimg=1;backup=1
/init_boot          emmc      /dev/block/by-name/init_boot          flags=display="init_boot";flashimg=1;backup=1
/vendor_boot        emmc      /dev/block/by-name/vendor_boot        flags=display="vendor_boot"flashimg=1;backup=1
/spu                emmc      /dev/block/by-name/spu                flags=display="spu"

# External storage
/external_sd	auto		/dev/block/mmcblk0p1	/dev/block/mmcblk0			flags=display="Micro SD Card";storage;wipeingui;removable
/usb_otg		auto		/dev/block/sdf1 		/dev/block/sdf				flags=display="USB OTG";storage;wipeingui;removable
